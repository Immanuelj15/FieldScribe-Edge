# FieldScribe Edge — Backend Configuration
# Nebius Token Factory / Nebius AI Cloud Credentials
# Obtain your API key from the Nebius Token Factory console: https://studio.nebius.ai/
NEBIUS_API_KEY=

# Nebius OpenAI-compatible API base URL
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Eligible NVIDIA Open-Source Model on Nebius Token Factory
# Models tested:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Recommended for precision extraction)
# - meta-llama/Meta-Llama-3.1-70B-Instruct
# - nvidia/Nemotron-4-340B-Instruct
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
