# FieldScribe Edge — Backend Configuration

# Active AI Provider: "ollama" | "nebius" | "demo"
# - ollama: Uses local Ollama instance (e.g. nemotron, nemotron-mini, llama3.2)
# - nebius: Uses Nebius Token Factory Cloud API with NVIDIA Nemotron-70B
# - demo: Uses deterministic rule-based local safety engine (no LLM required)
AI_PROVIDER=ollama

# Ollama Configuration (Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
# Models supported: nemotron, nemotron-mini, llama3.2, mistral, etc.
OLLAMA_MODEL=nemotron
OLLAMA_TIMEOUT=120.0

# Nebius Token Factory / Nebius AI Cloud Credentials
# Obtain your API key from the Nebius Token Factory console: https://studio.nebius.ai/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
NEBIUS_TIMEOUT=45.0

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
